#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 2, std140) uniform Params
{
    vec4 uColor;
    vec4 uPlace;
};

layout(set = 3, binding = 0, rgba8) uniform writeonly image2D uImage;

void main()
{
    imageStore(uImage, ivec2(gl_GlobalInvocationID.xy), uColor);
}
